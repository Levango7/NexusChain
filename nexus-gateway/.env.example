# ConPay Gateway - Environment Variables
# Copy this file to .env and fill in production values.

# Database
CPAY_DB_USERNAME=conpay
CPAY_DB_PASSWORD=change_me_in_production

# Webhook
CPAY_WEBHOOK_SECRET=change_me_in_production

# Chain Node RPC
CPAY_CHAIN_RPC_URL=http://localhost:8545

# Exchange Wallet Service
CPAY_WALLET_BASE_URL=http://localhost:8081

# Keystore (dev only, use Vault/HSM in production)
CPAY_KEYSTORE_PATH=

# === B-24 修复：LocalFileKeyManager 私钥加密存储 ===
# Base64 编码的 32 字节 AES-256 密钥，用于加密本地 keystore 文件。
# 生产环境通过此环境变量注入，不落配置文件。dev profile 已有默认开发密钥。
# 生成方式：python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
NEX_LOCAL_KEYSTORE_KEY=