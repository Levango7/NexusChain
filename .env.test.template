# ============================================================
# NexusChain 测试环境变量模板（REQ-10/P2 / REQ-23/P2 / REQ-24/P2）
# 用法：复制为 .env.test（已被 .gitignore 忽略），按实际环境填值
#   cp .env.test.template .env.test
# CI 测试作业通过 secrets 注入同名环境变量即可
# ============================================================

# KeystoreTests 用的测试密码（默认值与 testJson 中密文兼容；
# 若自定义密码需重新生成 testJson 中的 ciphertext/mac/salt）
KEYSTORE_TEST_PASSWORD=yongyang2018

# nexus-core 本地联调数据库密码（application-local.properties）
DB_PASSWORD=nexus123

# Seata DB 凭据（nacos-config/seata-server.properties）
SEATA_DB_USER=root
SEATA_DB_PASSWORD=root

# ZK 证明系统（A1-R1：默认启用真实 Groth16 远程服务；测试/无服务环境置空禁用）
# ZK_PROVER_ENABLED=true
# ZK_PROVER_BACKEND=groth16
# ZK_REMOTE_VERIFY_URL=http://localhost:50062/v1/verify
# ZK_REMOTE_PROVE_URL=http://localhost:50062/v1/prove
# ZK_MOCK_ALLOW_VERIFY=false