<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        P3-T5：trace_id / span_id MDC 注入（nexus-signing-service）
        Micrometer Tracing 自动将 traceId / spanId 写入 SLF4J MDC，
        日志 pattern 通过 %X{traceId} / %X{spanId} 引用。
        Loki + Promtail 通过提取 trace_id 标签实现 trace ↔ log 联动。

        P2-F1：新增 nexus.audit 专用 logger + appender，
        将私钥操作审计日志写入独立文件 /var/log/nexus/signing-audit.json，
        与业务日志隔离，便于合规审计与告警。
    -->
    <springProfile name="dev | sandbox">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] [%X{traceId:-},%X{spanId:-}] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <!-- P2-F1：审计日志 console appender（dev 环境与业务日志同流，便于调试） -->
        <appender name="AUDIT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [AUDIT] [%X{traceId:-}] %msg%n</pattern>
            </encoder>
        </appender>

        <logger name="nexus.audit" level="INFO" additivity="false">
            <appender-ref ref="AUDIT_CONSOLE" />
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/nexus/signing.json</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>/var/log/nexus/signing.%d{yyyy-MM-dd}.json</fileNamePattern>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <customFields>{"service":"nexus-signing-service","namespace":"nexus"}</customFields>
            </encoder>
        </appender>

        <!--
            P2-F1：审计日志专用 appender（prod 环境）
            - 独立文件 signing-audit.json，与业务日志 signing.json 隔离
            - 按天轮转，保留 90 天（合规审计要求 ≥ 90 天）
            - JSON 行格式（AuditLogService 已序列化为 JSON 字符串，
              此处用 PatternLayoutEncoder 原样输出，避免二次 JSON 包装）
            - 文件权限：部署时通过 Dockerfile / k8s securityContext 设置 0640，
              仅 nexus 用户与 audit 组可读
        -->
        <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/nexus/signing-audit.json</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>/var/log/nexus/signing-audit.%d{yyyy-MM-dd}.json</fileNamePattern>
                <maxHistory>90</maxHistory>
                <totalSizeCap>10GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%msg%n</pattern>
            </encoder>
        </appender>

        <logger name="nexus.audit" level="INFO" additivity="false">
            <appender-ref ref="AUDIT_FILE" />
        </logger>

        <root level="INFO">
            <appender-ref ref="JSON_FILE" />
        </root>
    </springProfile>
</configuration>
