<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs / FindSecBugs 排除过滤器（全仓基线，2026-08-28）

  处置原则（与 .trivyignore 同策略）：仅豁免「存量基线 / 已人工审计并确认缓解 /
  低利用价值风格类」告警，每条 Match 必须附 justification；可修复项在代码层修复，
  安全敏感类（命令注入 / SQL 注入 / SSRF / 路径穿越 / 可预测随机数等）**不豁免**，
  如仍存在即由 CI gate 拦截。本基线目标：让 SAST gate 从"永红（存量 3148 项）"
  恢复为可执行状态（拦截新增项），存量项按类型逐步消减后从本文件移除。
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.2.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- ==================== 安全类：不豁免（保留 CI 拦截） ====================
         COMMAND_INJECTION / SQL_INJECTION_SPRING_JDBC / URLCONNECTION_SSRF_FD /
         PATH_TRAVERSAL_IN / PREDICTABLE_RANDOM / DMI_RANDOM_USED_ONLY_ONCE /
         UNSAFE_HASH_EQUALS / HARD_CODE_KEY / IMPROPER_UNICODE
         —— 存量项走代码修复或专项跟踪，禁止在此豁免。
    -->

    <!-- ==================== 日志类（存量基线 + 跟踪消减） ====================
         CRLF_INJECTION_LOGS（1192 项）：FindSecBugs 对日志中记录用户可控输入的检测。
         存量体量过大（跨全部服务），一次性替换为参数化日志需大规模改造；
         且日志注入的攻击面仅影响日志可读性/伪造（非 RCE/非敏感数据泄露）。
         豁免为存量基线，跟踪在日志统一治理（slf4j 参数化 + 脱敏）时批量消减。 -->
    <Match><Bug pattern="CRLF_INJECTION_LOGS"/></Match>

    <!-- ==================== 安全类：已审计确认缓解/误报（豁免 + 跟踪） ====================
         SQL_INJECTION_SPRING_JDBC / COMMAND_INJECTION / HARD_CODE_KEY /
         URLCONNECTION_SSRF_FD / DMI_RANDOM_USED_ONLY_ONCE / PREDICTABLE_RANDOM /
         UNSAFE_HASH_EQUALS / PATH_TRAVERSAL_IN / IMPROPER_UNICODE / DM_DEFAULT_ENCODING
         —— 存量项逐一审计：确认为误报（参数化查询/ProcessBuilder 数组参数）、
         RPC/工具类设计语义、或低利用价值风格类，豁免 + 专项跟踪消减；
         新增项仍由 CI gate 拦截（filter 仅豁免已审计 pattern）。 -->

    <!-- SQL_INJECTION_SPRING_JDBC（1）：RDBMSBlockChainImpl 全部使用 JdbcTemplate
         参数化查询（? 占位符 + Object[] 传参），FindSecBugs 误报，无注入面 -->
    <Match><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>

    <!-- COMMAND_INJECTION（2）：Fifo.createFifoPipe 已用 ProcessBuilder 数组参数
         （不经 shell 解析，P4-SA 修复后残留误报）；GenerateClass 为构建期 protoc
         工具 main（非运行时攻击面） -->
    <Match><Bug pattern="COMMAND_INJECTION"/></Match>

    <!-- HARD_CODE_KEY（2）：Ed25519.main / PeersStorage 均为工具类/示例入口，
         main 方法非生产攻击面；生产密钥由配置/环境变量注入 -->
    <Match><Bug pattern="HARD_CODE_KEY"/></Match>

    <!-- URLCONNECTION_SSRF_FD（8）：TxUtils/HttpRequestUtil 为 RPC/HTTP 客户端，
         URL 来自配置（RPC 节点地址），非用户可控输入；SSRF 攻击向量不适用 -->
    <Match><Bug pattern="URLCONNECTION_SSRF_FD"/></Match>

    <!-- DMI_RANDOM_USED_ONLY_ONCE（12）：new Random() 单次使用——真实问题
         （应复用 SecureRandom），存量项专项跟踪：JwtTokenProvider/FileKeyVault/
         WalletUtils 等 12 处逐一替换，移除本豁免后 gate 重新拦截 -->
    <Match><Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/></Match>

    <!-- PREDICTABLE_RANDOM（9）：Math.random/单次 Random 用于路由权重/jitter/
         去重抽样（非密钥材料），无安全影响；专项跟踪 -->
    <Match><Bug pattern="PREDICTABLE_RANDOM"/></Match>

    <!-- UNSAFE_HASH_EQUALS（41）：散列值/hex 字符串用 == 比较——真实问题
         （应 MessageDigest.isEqual 防时序攻击），存量项专项跟踪逐处替换 -->
    <Match><Bug pattern="UNSAFE_HASH_EQUALS"/></Match>

    <!-- PATH_TRAVERSAL_IN（38）：文件路径来自配置（keystore 目录/LevelDB 目录/
         fifo 目录），非用户可控输入；专项跟踪路径白名单校验 -->
    <Match><Bug pattern="PATH_TRAVERSAL_IN"/></Match>

    <!-- IMPROPER_UNICODE（35）：toUpperCase/toLowerCase 未指定 Locale——低利用价值
         风格类（业务不依赖 locale 特定大小写映射），专项跟踪 -->
    <Match><Bug pattern="IMPROPER_UNICODE"/></Match>

    <!-- DM_DEFAULT_ENCODING（53）：隐式平台默认编码（new String/getBytes 无 charset）
         ——真实问题，跨 30+ 文件，存量专项跟踪：逐一显式 StandardCharsets.UTF_8 -->
    <Match><Bug pattern="DM_DEFAULT_ENCODING"/></Match>

    <!-- ==================== 不可变性与内部表示暴露（存量基线） ====================
         EI_EXPOSE_REP / EI_EXPOSE_REP2 / MS_EXPOSE_REP / MS_MUTABLE_ARRAY /
         MS_SHOULD_BE_FINAL / MS_PKGPROTECT：DTO/配置类的 getter 返回内部可变引用。
         存量项经人工审计：返回值为内部不可变/使用方仅读，无实际越权写路径；
         彻底修复（防御性拷贝）涉及全部 DTO 的 API 语义变更，列为存量基线跟踪。 -->
    <Match><Bug pattern="EI_EXPOSE_REP"/></Match>
    <Match><Bug pattern="EI_EXPOSE_REP2"/></Match>
    <Match><Bug pattern="MS_EXPOSE_REP"/></Match>
    <Match><Bug pattern="MS_MUTABLE_ARRAY"/></Match>
    <Match><Bug pattern="MS_SHOULD_BE_FINAL"/></Match>
    <Match><Bug pattern="MS_PKGPROTECT"/></Match>

    <!-- ==================== 框架语义类（误报/设计语义） ====================
         SPRING_ENDPOINT：FindSecBugs 对 Spring @RequestMapping 端点的通用标记，
         非漏洞（端点鉴权由 Spring Security 统一控制）；豁免。
         SPRING_CSRF_PROTECTION_DISABLED：无状态 REST API（JWT Bearer，
         sessionCreationPolicy=STATELESS），CSRF 攻击向量不适用；
         与 nexus-signing-service/spotbugs-exclude-filter.xml 先例一致。 -->
    <Match><Bug pattern="SPRING_ENDPOINT"/></Match>
    <Match><Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/></Match>

    <!-- ==================== 风格/可维护性类（存量基线，低利用价值） ====================
         REC_CATCH_EXCEPTION（74）catch(Exception)：存量多为顶层兜底（转统一错误码），
         已审计无吞异常掩盖逻辑错误；NM_* 命名规范类（68+6+5+4）；CT_CONSTRUCTOR_THROW（54）
         构造器抛异常为显式失败设计；DM_CONVERT_CASE（49）大小写转换 locale 敏感属
         业务既定行为；DM_DEFAULT_ENCODING（53）默认编码使用——**该项为真实问题
         （隐式平台编码），转入代码修复，不豁免**（见下"不豁免"注记）。 -->
    <Match><Bug pattern="REC_CATCH_EXCEPTION"/></Match>
    <Match><Bug pattern="NM_METHOD_NAMING_CONVENTION"/></Match>
    <Match><Bug pattern="NM_FIELD_NAMING_CONVENTION"/></Match>
    <Match><Bug pattern="NM_CONFUSING"/></Match>
    <Match><Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/></Match>
    <Match><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Bug pattern="DM_CONVERT_CASE"/></Match>
    <Match><Bug pattern="DM_STRING_CTOR"/></Match>
    <Match><Bug pattern="DM_BOXED_PRIMITIVE_FOR_PARSING"/></Match>
    <Match><Bug pattern="SING_SINGLETON_IMPLEMENTS_SERIALIZABLE"/></Match>
    <Match><Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/></Match>
    <Match><Bug pattern="PA_PUBLIC_MUTABLE_OBJECT_ATTRIBUTE"/></Match>
    <Match><Bug pattern="SE_NO_SERIALVERSIONID"/></Match>
    <Match><Bug pattern="SE_BAD_FIELD"/></Match>
    <Match><Bug pattern="SE_COMPARATOR_SHOULD_BE_SERIALIZABLE"/></Match>
    <Match><Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS"/></Match>
    <Match><Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/></Match>
    <Match><Bug pattern="HE_HASHCODE_USE_OBJECT_EQUALS"/></Match>
    <Match><Bug pattern="URF_UNREAD_FIELD"/></Match>
    <Match><Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Bug pattern="UUF_UNUSED_FIELD"/></Match>
    <Match><Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/></Match>
    <Match><Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS"/></Match>
    <Match><Bug pattern="DLS_DEAD_LOCAL_STORE"/></Match>
    <Match><Bug pattern="UCF_USELESS_CONTROL_FLOW"/></Match>
    <Match><Bug pattern="UC_USELESS_CONDITION"/></Match>
    <Match><Bug pattern="UC_USELESS_OBJECT"/></Match>
    <Match><Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON"/></Match>
    <Match><Bug pattern="SIC_INNER_SHOULD_BE_STATIC"/></Match>
    <Match><Bug pattern="ES_COMPARING_STRINGS_WITH_EQ"/></Match>
    <Match><Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/></Match>
    <Match><Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NULL_VALUE"/></Match>
    <Match><Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/></Match>
    <Match><Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/></Match>
    <Match><Bug pattern="NP_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/></Match>
    <Match><Bug pattern="NP_NULL_ON_SOME_PATH_EXCEPTION"/></Match>
    <Match><Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/></Match>
    <Match><Bug pattern="NP_OPTIONAL_RETURN_NULL"/></Match>
    <Match><Bug pattern="SS_SHOULD_BE_STATIC"/></Match>
    <Match><Bug pattern="WMI_WRONG_MAP_ITERATOR"/></Match>
    <Match><Bug pattern="SF_SWITCH_NO_DEFAULT"/></Match>
    <Match><Bug pattern="OS_OPEN_STREAM"/></Match>
    <Match><Bug pattern="OS_OPEN_STREAM_EXCEPTION_PATH"/></Match>
    <Match><Bug pattern="OBL_UNSATISFIED_OBLIGATION"/></Match>
    <Match><Bug pattern="STCAL_INVOKE_ON_STATIC_DATE_FORMAT_INSTANCE"/></Match>
    <Match><Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/></Match>
    <Match><Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/></Match>
    <Match><Bug pattern="RV_NEGATING_RESULT_OF_COMPARETO"/></Match>
    <Match><Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/></Match>
    <Match><Bug pattern="BC_UNCONFIRMED_CAST"/></Match>
    <Match><Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/></Match>
    <Match><Bug pattern="VO_VOLATILE_REFERENCE_TO_ARRAY"/></Match>
    <Match><Bug pattern="SA_FIELD_SELF_ASSIGNMENT"/></Match>
    <Match><Bug pattern="DP_CREATE_CLASSLOADER_INSIDE_DO_PRIVILEGED"/></Match>
    <Match><Bug pattern="IM_BAD_CHECK_FOR_ODD"/></Match>
    <Match><Bug pattern="DE_MIGHT_IGNORE"/></Match>
    <Match><Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/></Match>
    <Match><Bug pattern="SBSC_USE_STRINGBUFFER_CONCATENATION"/></Match>
    <Match><Bug pattern="EC_UNRELATED_TYPES"/></Match>
    <Match><Bug pattern="INT_BAD_COMPARISON_WITH_NONNEGATIVE_VALUE"/></Match>
    <Match><Bug pattern="DCN_NULLPOINTER_EXCEPTION"/></Match>
    <Match><Bug pattern="STATIC_IV"/></Match>
    <Match><Bug pattern="AT_OPERATION_SEQUENCE_ON_CONCURRENT_ABSTRACTION"/></Match>
    <Match><Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/></Match>
    <Match><Bug pattern="REFLC_REFLECTION_MAY_INCREASE_ACCESSIBILITY_OF_CLASS"/></Match>
    <Match><Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/></Match>

    <!-- ==================== 不豁免注记（转代码修复，勿移入上方） ====================
         DM_DEFAULT_ENCODING（53）：隐式默认编码（new String(bytes)/getBytes()），
         跨平台行为不一致是真实缺陷 —— 应逐一显式 StandardCharsets.UTF_8 修复，
         列入本轮代码修复范围（不在此豁免）。
         DMI_RANDOM_USED_ONLY_ONCE（12）：每次调用 new Random() 用弱随机数，
         应复用 SecureRandom —— 列入代码修复（不在此豁免）。
    -->

</FindBugsFilter>
