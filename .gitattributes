# Normalize line endings for cross-OS development (Windows CRLF / Linux LF)
# -----------------------------------------------------------------------------
# gradlew 必须为 LF：CI 在 Linux runner 上执行 ./gradlew，CRLF 会导致
#   /usr/bin/env: bad interpreter: No such file or directory
# gradlew.bat 保留 CRLF：Windows 批�脚本传统行结束符
# 其余文本文件由 git autocrlf 自动处理（core.autocrlf=true on Windows）
gradlew text eol=lf
gradlew.bat text eol=crlf

# Shell 脚本统一 LF，避免 Linux 上执行失败
*.sh text eol=lf

# Dockerfile 统一 LF（Linux 构建环境）
Dockerfile text eol=lf
*.dockerfile text eol=lf

# YAML/JSON 配置统一 LF（CI 解析）
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# 二进制文件标记，避免误改
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.keystore binary
*.jks binary
*.p12 binary
*.key binary
*.crt binary
*.pem binary