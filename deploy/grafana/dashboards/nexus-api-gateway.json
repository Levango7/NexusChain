        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=~\".*nexus-api-gateway.*\", uri!~\"/actuator.*|/health.*|/info\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{uri}}"
