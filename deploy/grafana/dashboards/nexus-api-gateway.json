      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*nexus-api-gateway.*\", uri!~\"/actuator.*|/health.*|/info\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
