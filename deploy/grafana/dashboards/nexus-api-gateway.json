          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*nexus-api-gateway.*\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=~\".*nexus-api-gateway.*\"}[$__rate_interval])), 1)",
          "refId": "A",
          "legendFormat": "",
          "instant": true
