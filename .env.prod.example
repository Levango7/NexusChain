# docker-compose.prod.yml 的必填环境变量清单（15 项）
# ============================================================================
# 2026-10-06 起，prod 编排里这些变量**没有默认值**：少任何一个，
# `docker compose -f docker-compose.prod.yml --env-file .env.prod config`
# 会在插值阶段直接报错退出（fail-closed）。
#
# 改前的行为是 `${VAR:-CHANGE_ME_*}`——少设不报错，而是**用一份写在公开仓库里的
# 占位口令把"生产"栈起来**。其中 MPC_STORAGE_KEY 是 mpc-engine 份额落盘
# （AES-GCM）的加密主钥，用占位值等于门限密钥材料被可预测密钥保护。
#
# 用法：复制成 .env.prod，逐项填真值（不要提交 .env.prod）。
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod config -q   # 自检
# ============================================================================

# --- mpc-engine（3 节点共用；份额加密主钥 + 节点间鉴权 token）---
MPC_STORAGE_KEY=
MPC_AUTH_TOKEN=

# --- Nacos（集群鉴权：identity 双因子 + 管理员账号 + JWT token）---
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_AUTH_TOKEN=
NACOS_USERNAME=
NACOS_PASSWORD=

# --- Seata（配置中心 key；DB 密码复用 POSTGRES_PASSWORD）---
SEATA_CONFIG_KEY=

# --- Sentinel 控制台 ---
SENTINEL_USERNAME=
SENTINEL_PASSWORD=

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Grafana 管理员 ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
