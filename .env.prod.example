# docker-compose.prod.yml 的必填环境变量清单（19 项）
# ============================================================================
# 2026-10-06 起，prod 编排里这些变量**没有默认值**：少任何一个，
# `docker compose -f docker-compose.prod.yml --env-file .env.prod config`
# 会在插值阶段直接报错退出（fail-closed）。
#
# 改前的行为是 `${VAR:-CHANGE_ME_*}`——少设不报错，而是**用一份写在公开仓库里的
# 占位口令把"生产"栈起来**。其中 MPC_STORAGE_KEY 是 mpc-engine 份额落盘
# （AES-GCM）的加密主钥，用占位值等于门限密钥材料被可预测密钥保护。
#
# 用法：复制成 .env.prod，逐项填真值（不要提交 .env.prod）。
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod config -q   # 自检
# ============================================================================

# --- mpc-engine（3 节点共用；份额加密主钥 + 节点间鉴权 token）---
MPC_STORAGE_KEY=
MPC_AUTH_TOKEN=

# --- JWT（gateway ⇄ signing 共享密钥；HS256 ≥ 32 字节）---
# 2026-10-18 补：此前漏列——两端缺注入时 JwtTokenProvider 退化为进程内随机
# 密钥，跨服务验签必然失败（signing 签发的 token 网关验不过）。
JWT_SECRET=

# --- Nacos（集群鉴权：identity 双因子 + 管理员账号 + JWT token）---
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_AUTH_TOKEN=
NACOS_USERNAME=
NACOS_PASSWORD=

# --- Seata（配置中心 key；DB 密码复用 POSTGRES_PASSWORD）---
SEATA_CONFIG_KEY=

# --- Sentinel 控制台 ---
SENTINEL_USERNAME=
SENTINEL_PASSWORD=

# --- PostgreSQL 16（**仅供 core**：链状态 JDBC 存储为 PG 方言，见 docker-compose.prod.yml core 段注释）---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=

# --- MySQL 8（业务五库；2026-10-12 由 PostgreSQL 切换而来，族对齐见 ADR-033 / 各服务 application-prod.yml）---
# MYSQL_ROOT_PASSWORD：仅容器内 root（初始化与 DBA 运维）
# MYSQL_PASSWORD：业务口令 —— 五个库（gateway/wallet/signing/bridge/seata）的
#   专用账号与通用账号 nexus 都用它；见 deploy/config/init-mysql-dbs.sh
MYSQL_ROOT_PASSWORD=
MYSQL_USER=nexus
MYSQL_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Grafana 管理员 ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
